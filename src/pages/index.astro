  <meta property="og:description" content="Three automated MNQ futures bots on one IBKR account, with live-replica backtests on real data and a live dashboard." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Nemesis Protocol" />
