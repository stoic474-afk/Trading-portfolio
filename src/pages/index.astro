---
import '../styles/global.css';

// 1-year backtest, Oct 2025 – Sep 2026: [month, NY ICT, NY scalp, Asia] — each bot's live rules, real IBKR data
const months = [
  ['Oct 2025', 464, -1080, -922], ['Nov 2025', 2912, 6414, 3840], ['Dec 2025', 4015, 720, 4342],
  ['Jan 2026', 568, 7200, 1440], ['Feb 2026', 1340, -720, 960], ['Mar 2026', 4676, -1080, -720],
  ['Apr 2026', -1328, -1800, 2160], ['May 2026', 2258, 720, 720], ['Jun 2026', 1509, 2880, 2640],
  ['Jul 2026', 1700, 1080, 1920], ['Aug 2026', -1325, 2160, 0], ['Sep 2026', 224, 2160, 240],
];
const money = (v) => (v > 0 ? '+' : v < 0 ? '−' : '') + '$' + Math.abs(v).toLocaleString('en-US');
const cls = (v) => (v > 0 ? 'pos-t' : v < 0 ? 'neg-t' : 'dim');
