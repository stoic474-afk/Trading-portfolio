<span class="ln"></span>    <span class="st">"""This bot's net MNQ position from its own fills today.</span>
<span class="ln"></span><span class="st">    ib.positions() is the whole account's net position, which</span>
<span class="ln"></span><span class="st">    includes the scalp and Asia bots' contracts."""</span>
<span class="ln"></span>    today <span class="op">=</span> datetime.now(ET).date()
<span class="ln"></span>    pos <span class="op">=</span> <span class="nm">0.0</span>
<span class="ln"></span>    <span class="kw">for</span> f <span class="kw">in</span> ib.fills():
<span class="ln"></span>        <span class="kw">if</span> (f.execution.clientId <span class="op">==</span> CLIENT_ID <span class="kw">and</span> f.contract.conId <span class="op">==</span> contract.conId
<span class="ln"></span>                <span class="kw">and</span> f.time.astimezone(ET).date() <span class="op">==</span> today):
<span class="ln"></span>            pos <span class="op">+=</span> f.execution.shares <span class="kw">if</span> f.execution.side <span class="op">==</span> <span class="st">"BOT"</span> <span class="kw">else</span> <span class="op">-</span>f.execution.shares
<span class="ln"></span>    <span class="kw">return</span> <span class="bi">int</span>(<span class="bi">round</span>(pos))
<span class="ln"></span>
<span class="ln"></span><span class="cm"># The 11:00 force-close and the end-of-day cleanup cancel only orders tagged</span>
<span class="ln"></span><span class="cm"># with this bot's clientId and close only this position — never the account total.</span></pre>
