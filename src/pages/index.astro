  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nemesis Protocol</title>
  <meta name="description" content="Three automated MNQ futures bots on one Interactive Brokers account — NY-open ICT model, opening-range scalper and Asia-session OTE continuation — with live-replica backtests on real data." />
